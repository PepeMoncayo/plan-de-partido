# Cliente (se exponen al navegador: solo la URL y la anon key, nunca la service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Proveedor de IA: mock (por defecto) | claude (requiere implementar /api/ai)
VITE_AI_PROVIDER=mock

# Servidor (solo en Vercel → Settings → Environment Variables, sin prefijo VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VIMEO_ACCESS_TOKEN=
